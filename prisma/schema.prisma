generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AuditRequestStatus {
  preview_created
  email_submitted
  report_ready
  failed
}

model Lead {
  id               String         @id @default(cuid())
  email            String         @unique
  name             String?
  company          String?
  phone            String?
  consentToContact Boolean        @default(false)
  source           String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  auditRequests    AuditRequest[]
  emailEvents      EmailEvent[]

  @@index([email])
  @@map("leads")
}

model AuditRequest {
  id               String             @id @default(cuid())
  reportToken      String             @unique @default(cuid())
  websiteUrl       String
  normalizedDomain String
  leadId           String?
  lead             Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  status           AuditRequestStatus @default(preview_created)
  overallScore     Int?
  previewJson      Json
  reportJson       Json?
  ipHash           String?
  userAgent        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  emailEvents      EmailEvent[]

  @@index([normalizedDomain])
  @@index([status])
  @@index([createdAt])
  @@index([leadId])
  @@map("audit_requests")
}

enum EmailEventType {
  user_report
  internal_lead_notification
}

enum EmailEventStatus {
  sent
  failed
  skipped
}

model EmailEvent {
  id                  String           @id @default(cuid())
  auditRequestId      String
  auditRequest        AuditRequest     @relation(fields: [auditRequestId], references: [id], onDelete: Cascade)
  leadId              String?
  lead                Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  type                EmailEventType
  status              EmailEventStatus
  recipientEmailHash  String
  recipientDomain     String?
  provider            String
  providerMessageId   String?
  errorCode           String?
  createdAt           DateTime         @default(now())

  @@index([auditRequestId])
  @@index([leadId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("email_events")
}
